{{- $pages := where site.RegularPages "Section" "noticias" -}}
{{- $categorias := dict -}}
{{- $ultimas := slice -}}

{{/* Descubrir todas las categorías */}}
{{- range $pages }}
  {{- range .Params.categorias }}
    {{- if not (isset $categorias .) }}
      {{- $categorias = merge $categorias (dict . true) }}
    {{- end }}
  {{- end }}
{{- end }}

{{/* Obtener la noticia más reciente de cada categoría */}}
{{- range $categoria, $_ := $categorias }}
  {{- $ultima := index (
      sort
      (where $pages "Params.categorias" "intersect" (slice $categoria))
      "Date"
      "desc"
    ) 0 }}

  {{- if $ultima }}
    {{- $ultimas = $ultimas | append $ultima }}
  {{- end }}
{{- end }}

{{/* Ordenar esas noticias por fecha y quedarse solo con las 4 más recientes */}}
{{- $ultimas = first 4 (sort $ultimas "Date" "desc") -}}

[
{{- range $i, $post := $ultimas }}
  {{- if gt $i 0 }},{{ end }}
  {
    "category": {{ index $post.Params.categorias 0 | jsonify }},
    "title": {{ $post.Title | jsonify }},
    "subtitle": {{ $post.Params.subtitle | jsonify }},
    "date": {{ $post.Date.Format "2006-01-02" | jsonify }},
    "image": {{ printf "https://sanfranciscoysantaclara.es%s" $post.Params.image | jsonify }},
    "url": {{ $post.RelPermalink | jsonify }}
  }
{{- end }}
]