{{- $pages := where site.RegularPages "Section" "noticias" -}}
{{- $categorias := dict -}}
{{- $ultimas := slice -}}

{{/* ==========================================================
   CREAR LISTA DE NOTICIAS ACTIVAS

   Cada elemento contiene:
   - page → la página original
   - fecha → fecha efectiva para ordenar
========================================================== */}}

{{- $activePosts := slice -}}

{{- range $pages }}

  {{- $resultado := partial "fecha-recurrente.html" . -}}

  {{- if $resultado.activa }}

    {{- $activePosts = $activePosts | append (dict
        "page" .
        "fecha" $resultado.fecha
      )
    -}}

  {{- end }}

{{- end }}


{{/* ==========================================================
   DESCUBRIR TODAS LAS CATEGORÍAS
========================================================== */}}

{{- range $post := $activePosts }}

  {{- range $post.page.Params.categorias }}

    {{- if not (isset $categorias .) }}
      {{- $categorias = merge $categorias (dict . true) }}
    {{- end }}

  {{- end }}

{{- end }}


{{/* ==========================================================
   OBTENER LA NOTICIA MÁS RECIENTE DE CADA CATEGORÍA

   IMPORTANTE:
   Ordenamos por "fecha", no por .Date.
========================================================== */}}

{{- range $categoria, $_ := $categorias }}

  {{- $postsCategoria := where $activePosts "page.Params.categorias" "intersect" (slice $categoria) -}}

  {{- $ordenados := sort $postsCategoria "fecha" "desc" -}}

  {{- $ultima := index $ordenados 0 -}}

  {{- if $ultima }}
    {{- $ultimas = $ultimas | append $ultima -}}
  {{- end }}

{{- end }}


{{/* ==========================================================
   ORDENAR LAS CATEGORÍAS POR LA FECHA DE SU ÚLTIMA NOTICIA
   Y QUEDARNOS CON LAS 4 MÁS RECIENTES
========================================================== */}}

{{- $ultimas = first 4 (sort $ultimas "fecha" "desc") -}}


[
{{- range $i, $post := $ultimas }}

  {{- if gt $i 0 }},{{ end }}

  {
    "category": {{ index $post.page.Params.categorias 0 | jsonify }},
    "title": {{ $post.page.Title | jsonify }},
    "subtitle": {{ $post.page.Params.subtitle | jsonify }},
    "date": {{ $post.fecha.Format "2006-01-02" | jsonify }},
    "image": {{ printf "https://sanfranciscoysantaclara.es%s" $post.page.Params.image | jsonify }},
    "url": {{ $post.page.RelPermalink | jsonify }}
  }

{{- end }}
]