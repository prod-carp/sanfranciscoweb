{{- $pages := where site.RegularPages "Section" "noticias" -}}
{{- $categorias := dict -}}

{{/* Descubrir todas las categorías existentes */}}
{{- range $pages }}
  {{- range .Params.categorias }}
    {{- if not (isset $categorias .) }}
      {{- $categorias = merge $categorias (dict . true) }}
    {{- end }}
  {{- end }}
{{- end }}

[
{{- $first := true -}}

{{- range $categoria, $_ := $categorias }}

  {{- $ultima := index (
      sort
      (where $pages "Params.categorias" "intersect" (slice $categoria))
      "Date"
      "desc"
    ) 0 }}

  {{- if $ultima }}

    {{- if not $first }},{{ end }}
    {{- $first = false }}

    {
      "category": {{ $categoria | jsonify }},
      "title": {{ $ultima.Title | jsonify }},
      "subtitle": {{ $ultima.Params.subtitle | jsonify }},
      "date": {{ $ultima.Date.Format "2006-01-02" | jsonify }},
      "image": {{ printf "https://sanfranciscoysantaclara.es%s" $ultima.Params.image | jsonify }},
      "url": {{ $ultima.RelPermalink | jsonify }}
    }

  {{- end }}

{{- end }}
]